# このファイルを .env にコピーして使う。.env は git に含めないこと。

# 保存済みAPIキーを暗号化するための鍵（Fernet形式のbase64文字列）。
# 未設定の場合は初回起動時に backend/.secret.key を自動生成する。
# この鍵を失うと、保存済みのGemini APIキーは復号できなくなる（再入力すれば復旧する）。
TOKEN_ENCRYPTION_KEY=

# Gemini APIキーの既定値（任意）。
# 通常はWebアプリの設定画面から登録するため、ここは空でよい。
# 両方ある場合は「設定画面で登録した値」が優先される。
GEMINI_API_KEY=

# フロントエンドのオリジン（CORS許可先）。カンマ区切りで複数指定できる。
CORS_ORIGINS=http://localhost:8765,http://localhost:5173

# 外部への通信がプロキシ経由でしか通らない環境で設定する（学内ネットワークなど）。
# 起動時に環境変数として読み込まれ、Gemini SDK（内部でhttpxを使用）がそのまま利用する。
# 学外では空にすること。設定したままだと逆に接続できなくなる。
# 例: HTTPS_PROXY=http://wwwproxy-a10.kanazawa-it.ac.jp:8080
HTTPS_PROXY=
HTTP_PROXY=
