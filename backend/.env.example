# このファイルを .env にコピーして使う。.env は git に含めないこと。

# 保存済みAPIキーを暗号化するための鍵（Fernet形式のbase64文字列）。
# 未設定の場合は初回起動時に backend/.secret.key を自動生成する。
# この鍵を失うと、保存済みのGemini APIキーは復号できなくなる（再入力すれば復旧する）。
TOKEN_ENCRYPTION_KEY=

# Gemini APIキーの既定値（任意）。
# 通常はWebアプリの設定画面から登録するため、ここは空でよい。
# 両方ある場合は「設定画面で登録した値」が優先される。
GEMINI_API_KEY=

# Google OAuth クライアント（任意）。Calendar / Tasks / Gmail 連携に必要。
# Google Cloud Console でプロジェクトを作り、OAuthクライアント（種別: ウェブアプリケーション）を
# 登録して取得する。回避手段は存在しない（docs/design.md §7.2）。
# 承認済みリダイレクトURIに次を登録すること:
#   http://localhost:8000/api/v1/auth/google/callback
# 通常は設定APIから登録するため、ここは空でよい。両方ある場合は設定API側が優先される。
# 公開せず自分だけで使う場合、OAuth同意画面は「テスト」のままでよい（審査不要）。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# フロントエンドのオリジン（CORS許可先）。カンマ区切りで複数指定できる。
CORS_ORIGINS=http://localhost:8765,http://localhost:5173

# 外部への通信がプロキシ経由でしか通らない環境で設定する（学内ネットワークなど）。
# 起動時に環境変数として読み込まれ、Gemini SDK（内部でhttpxを使用）がそのまま利用する。
# 学外では空にすること。設定したままだと逆に接続できなくなる。
# 例: HTTPS_PROXY=http://<proxy-host>:8080
HTTPS_PROXY=
HTTP_PROXY=
