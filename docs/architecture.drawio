                <mxCell id="p3_start" value="GET /api/v1/daily-plan?lat=&amp;lon=&#xa;省略時は野々市市（36.5297, 136.6094）" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#E8EEF4;strokeColor=#7A8C9E;" parent="1" vertex="1">
