                    </mxGeometry>
                </mxCell>
                <mxCell id="p3_f7" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;strokeColor=#6B7B8C;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" parent="1" source="p3_ok" target="p3_n2" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1060" y="282"/>
                            <mxPoint x="1060" y="407"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="p3_f8" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;strokeColor=#6B7B8C;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="p3_n2" target="p3_n3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3_f9" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;strokeColor=#6B7B8C;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="p3_n3" target="p3_n4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3_f10" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;strokeColor=#6B7B8C;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="p3_n4" target="p3_n5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3_f11" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;strokeColor=#6B7B8C;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="p3_n5" target="p3_n6" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3_f12" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;strokeColor=#6B7B8C;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="p3_n6" target="p3_end" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3_f13" value="気圧ストレスは&#xa;レベルの下限にも効く" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;strokeColor=#8A7A5A;dashed=1;fontSize=10;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" parent="1" source="p3_n2" target="p3_n5" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="820" y="407"/>
                            <mxPoint x="820" y="677"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="p3_memo1" value="気圧ストレス指数の配点（§4.1・thresholds.yaml）&#xa;絶対値ではなく変化率を主軸にする。標高の高い地域や台風一過の晴天日での誤判定を避けるため。&#xa;・直近6時間の低下：1hPa あたり 10点（上限 40）&#xa;・直近24時間の低下：1hPa あたり 3点（上限 30）&#xa;・これから6時間の予報低下：1hPa あたり 5点（上限 20）体調は先行して崩れるため&#xa;・1000hPa 未満の絶対値：補助指標として上限 10点" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FBFBF7;strokeColor=#C7C2B4;" parent="1" vertex="1">
                    <mxGeometry x="60" y="430" width="350" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="p3_memo2" value="体力予算の減点因子とキャップ（§4.2）&#xa;・気圧ストレス × 0.40 ……………… 最大 −40&#xa;・前日比の気温変化 …………………… 最大 −10&#xa;・不快指数（75超）…………………… 最大 −10&#xa;・睡眠不足（7時間基準）…………… 最大 −20 ※フェーズ2&#xa;・予定による拘束 ……………………… 最大 −15 ※Google連携&#xa;・要対応メール＋ToDo ……………… 最大 −5 ※Google連携&#xa;&#xa;単一因子が予算を食い尽くさないよう、すべてにキャップを置く。&#xa;未計測の因子は None のままで、内訳（breakdown）に現れない。&#xa;0（計測して負荷なし）と None（未計測）は区別する。" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FBFBF7;strokeColor=#C7C2B4;" parent="1" vertex="1">
                    <mxGeometry x="800" y="480" width="380" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="p3_memo3" value="レベルの決め方（§4.2.1・2026-08-01 決定）&#xa;予算由来：Lv1 = 80〜100／Lv2 = 60〜79／Lv3 = 40〜59／Lv4 = 20〜39／Lv5 = 0〜19&#xa;気圧由来の下限：ストレス 90以上→Lv5／75以上→Lv4／55以上→Lv3／35以上→Lv2&#xa;&#xa;これは「下限」であって「固定」ではない。フェーズ2以降で睡眠不足や拘束が加わり、&#xa;予算由来のレベルがより深くなればそちらが勝つ。&#xa;&#xa;なぜ必要か：気象因子の上限は 100 × 0.40 = 40点。フェーズ1で引ける点は&#xa;気象40＋気温10＋湿度10 = 最大60 しかなく、純粋な予算モデルでは Lv4・Lv5 に到達できない。&#xa;台風接近が「省エネ（Lv3）」と表示され、気圧を掲げるプロダクトとして破綻する。&#xa;&#xa;※ 単純な予算しきい値へ戻さないこと。" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#F7F3EA;strokeColor=#A89878;" parent="1" vertex="1">
                    <mxGeometry x="60" y="640" width="330" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="p3_memo4" value="提案の選定ルール（§4.3・§1.2）&#xa;・そのレベル以下の負荷を持つプールからのみ選ぶ（上振れ禁止）&#xa;・許される上限に近い（＝重い）ものから選ぶ。軽い順だと全レベルで&#xa;　「何もしない」が筆頭になり、レベルの差が消える&#xa;・1日 最大3件。多いこと自体が負荷になるため&#xa;・Lv5 は1件のみ。「何もしないこと」が本日の目標&#xa;・チェックボックス相当のフィールドを持たせない（完了/未完了の概念を作らない）" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FBFBF7;strokeColor=#C7C2B4;" parent="1" vertex="1">
                    <mxGeometry x="800" y="720" width="380" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="p3_memo5" value="関連する未決事項　§11 #10：Google連携の減点は拘束15＋メール/ToDo 5 = 最大20点。予算は80止まりで、これはちょうどLv1の下限。&#xa;予定が詰まっているだけではレベルが動かない。連携は「レベルを変える機能」ではなく「気圧が悪い日の落ち込みを深める機能」として働く。" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;fillColor=#F7F3F3;strokeColor=#B08A8A;" parent="1" vertex="1">
                    <mxGeometry x="60" y="920" width="1120" height="60" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="page-data" name="4. データモデル">
        <mxGraphModel dx="1434" dy="641" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p4_title" value="データモデル（SQLite: backend/data/app.db）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="40" y="16" width="900" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="p4_note" value="スキーマは db.py の _SCHEMA が正本。起動時に lifespan → init_db() で CREATE TABLE IF NOT EXISTS を流す。テーブル間に外部キーはない（単一ユーザーのローカル運用のため）。" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#5A5A5A;" parent="1" vertex="1">
                    <mxGeometry x="40" y="44" width="1100" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="p4_label1" value="実装済み（db.py の _SCHEMA）" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="60" y="84" width="400" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="p4_t1" value="app_setting" style="swimlane;html=1;startSize=28;fillColor=#EDE7F0;strokeColor=#90809A;fontSize=12;fontStyle=1;align=center;" parent="1" vertex="1">
                    <mxGeometry x="60" y="120" width="290" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="p4_t1b" value="key         TEXT PRIMARY KEY&#xa;value       TEXT   — 平文で良い設定&#xa;encrypted   BLOB   — 機微な設定&#xa;updated_at  TEXT NOT NULL&#xa;&#xa;value と encrypted は排他利用。&#xa;Geminiのモデル名・APIキー、&#xa;GoogleのクライアントID/シークレット、&#xa;use_context フラグを持つ。" style="text;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;strokeColor=none;fillColor=none;" parent="p4_t1" vertex="1">
                    <mxGeometry y="28" width="290" height="152" as="geometry"/>
                </mxCell>
                <mxCell id="p4_t2" value="atmosphere_snapshot" style="swimlane;html=1;startSize=28;fillColor=#EDE7F0;strokeColor=#90809A;fontSize=12;fontStyle=1;align=center;" parent="1" vertex="1">
                    <mxGeometry x="390" y="120" width="330" height="255" as="geometry"/>
                </mxCell>
                <mxCell id="p4_t2b" value="id            INTEGER PK AUTOINCREMENT&#xa;observed_at   TEXT NOT NULL&#xa;latitude      REAL NOT NULL&#xa;longitude     REAL NOT NULL&#xa;pressure      REAL NOT NULL&#xa;temperature   REAL&#xa;humidity      REAL&#xa;stress_score  REAL NOT NULL&#xa;source        TEXT NOT NULL  — &#39;open-meteo&#39; | &#39;jma&#39;&#xa;raw_json      TEXT&#xa;&#xa;INDEX (latitude, longitude, id DESC)&#xa;通信断時のフォールバック元。地点で絞らないと&#xa;移動時に別の都市の値を今日の気圧として出す。&#xa;raw_json には再計算できる時系列を入れる。" style="text;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;strokeColor=none;fillColor=none;" parent="p4_t2" vertex="1">
                    <mxGeometry y="28" width="330" height="227" as="geometry"/>
                </mxCell>
                <mxCell id="p4_t3" value="reflection" style="swimlane;html=1;startSize=28;fillColor=#EDE7F0;strokeColor=#90809A;fontSize=12;fontStyle=1;align=center;" parent="1" vertex="1">
                    <mxGeometry x="760" y="120" width="330" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="p4_t3b" value="id          INTEGER PK AUTOINCREMENT&#xa;date        TEXT NOT NULL&#xa;user_text   TEXT NOT NULL&#xa;reply_text  TEXT NOT NULL&#xa;level       INTEGER&#xa;felt        INTEGER  — 1:つらい 2:普通 3:平気&#xa;created_at  TEXT NOT NULL&#xa;&#xa;夜の吐き出しの記録。felt は F-15（気圧耐性の&#xa;個人化）の学習用で NULL 可。記録の義務化はしない。" style="text;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;strokeColor=none;fillColor=none;" parent="p4_t3" vertex="1">
                    <mxGeometry y="28" width="330" height="172" as="geometry"/>
                </mxCell>
                <mxCell id="p4_t4" value="oauth_token" style="swimlane;html=1;startSize=28;fillColor=#EDE7F0;strokeColor=#90809A;fontSize=12;fontStyle=1;align=center;" parent="1" vertex="1">
                    <mxGeometry x="60" y="330" width="290" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="p4_t4b" value="provider    TEXT PRIMARY KEY — &#39;google&#39;&#xa;encrypted   BLOB NOT NULL&#xa;expires_at  TEXT&#xa;updated_at  TEXT NOT NULL&#xa;&#xa;Credentials.to_json() を Fernet で暗号化。&#xa;refresh_token を含むため、漏れると継続的に&#xa;カレンダーとメタデータへ触れられる。&#xa;返す経路はどのエンドポイントにもない。" style="text;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;strokeColor=none;fillColor=none;" parent="p4_t4" vertex="1">
                    <mxGeometry y="28" width="290" height="152" as="geometry"/>
                </mxCell>
                <mxCell id="p4_label2" value="設計書 §6 にあるが未実装" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#777777;" parent="1" vertex="1">
                    <mxGeometry x="60" y="545" width="400" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="p4_t5" value="sleep_log（フェーズ2 / F-04）" style="swimlane;html=1;startSize=28;fillColor=#F5F5F5;strokeColor=#9E9E9E;fontSize=12;fontStyle=1;align=center;dashed=1;fontColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="60" y="580" width="290" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="p4_t5b" value="date       TEXT PRIMARY KEY&#xa;bedtime    TEXT&#xa;wake_time  TEXT&#xa;created_at TEXT NOT NULL&#xa;&#xa;睡眠不足は予算の −20 枠。手入力が第一手段。" style="text;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;strokeColor=none;fillColor=none;fontColor=#666666;" parent="p4_t5" vertex="1">
                    <mxGeometry y="28" width="290" height="112" as="geometry"/>
                </mxCell>
                <mxCell id="p4_t6" value="activity_log（フェーズ3-4 / F-10・F-14）" style="swimlane;html=1;startSize=28;fillColor=#F5F5F5;strokeColor=#9E9E9E;fontSize=12;fontStyle=1;align=center;dashed=1;fontColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="390" y="580" width="330" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="p4_t6b" value="id         INTEGER PK AUTOINCREMENT&#xa;date       TEXT NOT NULL&#xa;category   TEXT NOT NULL — meal|move|rest|other&#xa;text       TEXT NOT NULL&#xa;created_at TEXT NOT NULL&#xa;&#xa;任意記録。無い日は行が存在しないだけ。" style="text;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;strokeColor=none;fillColor=none;fontColor=#666666;" parent="p4_t6" vertex="1">
                    <mxGeometry y="28" width="330" height="112" as="geometry"/>
                </mxCell>
                <mxCell id="p4_t7" value="personal_threshold（フェーズ5 / F-15）" style="swimlane;html=1;startSize=28;fillColor=#F5F5F5;strokeColor=#9E9E9E;fontSize=12;fontStyle=1;align=center;dashed=1;fontColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="760" y="580" width="330" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="p4_t7b" value="key        TEXT PRIMARY KEY&#xa;value      REAL NOT NULL&#xa;samples    INTEGER NOT NULL&#xa;updated_at TEXT NOT NULL&#xa;&#xa;20日分の記録が貯まってから係数のみ調整する。&#xa;式の構造は変えない（説明可能性を保つため）。" style="text;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;strokeColor=none;fillColor=none;fontColor=#666666;" parent="p4_t7" vertex="1">
                    <mxGeometry y="28" width="330" height="112" as="geometry"/>
                </mxCell>
                <mxCell id="p4_memo" value="書き込む側&#xa;・app_setting ← settings_store.py（routers/settings.py 経由）&#xa;・atmosphere_snapshot ← services/atmosphere.py（取得成功のたび）&#xa;・reflection ← routers/reflection.py（応答生成後）&#xa;・oauth_token ← oauth_store.py（services/google_oauth.py 経由）" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FBFBF7;strokeColor=#C7C2B4;" parent="1" vertex="1">
                    <mxGeometry x="760" y="345" width="330" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="p4_memo2" value="暗号化の境界：BLOB の encrypted 列（app_setting・oauth_token）は crypto.py の Fernet で暗号化する。鍵は backend/.env の TOKEN_ENCRYPTION_KEY。&#xa;APIから平文を返す経路は作らない。設定画面には crypto.mask() のマスク済み文字列だけを返す。" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;fillColor=#F7F3F3;strokeColor=#B08A8A;" parent="1" vertex="1">
                    <mxGeometry x="60" y="750" width="1030" height="60" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="page-frontend" name="5. フロントエンド構成">
        <mxGraphModel dx="1434" dy="641" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p5_title" value="フロントエンド構成（frontend/src・React + TypeScript + Vite）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="40" y="16" width="900" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="p5_note" value="サーバー状態は AtmosphereProvider の1箇所で取得し、Context 経由で配る。fetch と URL 組み立ては api/client.ts の外に書かない。" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#5A5A5A;" parent="1" vertex="1">
                    <mxGeometry x="40" y="44" width="1000" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="p5_entry" value="index.html → main.tsx&#xa;createRoot + StrictMode" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#E8EEF4;strokeColor=#7A8C9E;" parent="1" vertex="1">
                    <mxGeometry x="60" y="110" width="240" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="p5_dash" value="Dashboard.tsx&#xa;AtmosphereProvider で包み、&#xa;DashboardView が activeView を切り替える" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#E8EEF4;strokeColor=#7A8C9E;" parent="1" vertex="1">
                    <mxGeometry x="60" y="200" width="240" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p5_provider" value="context/AtmosphereProvider.tsx&#xa;/atmosphere と /daily-plan を Promise.all で並行取得&#xa;5分ごとに再取得（document.hidden のときは休む）&#xa;失敗しても前回値を残し error だけ立てる&#xa;AbortController で座標確定時の取り直しを中断" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#EDF3EE;strokeColor=#7C9A82;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="400" y="180" width="330" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="p5_ctx" value="context/atmosphereContext.ts&#xa;AtmosphereState { atmosphere, plan, isLoading, error, updatedAt }&#xa;useAtmosphere()" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#EDF3EE;strokeColor=#7C9A82;" parent="1" vertex="1">
                    <mxGeometry x="400" y="330" width="330" height="70" as="geometry"/>
