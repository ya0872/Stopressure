                <mxCell id="p3_f6" value="復元できた" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;strokeColor=#C79A6A;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="p3_ng" target="p3_n2" edge="1">
                    <mxGeometry relative="1" as="geometry">
