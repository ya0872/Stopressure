                </mxCell>
                <mxCell id="p3_end" value="DailyPlanResponse&#xa;energy_budget / level / level_name / headline /&#xa;pressure_stress / stale / breakdown / suggestions" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;fillColor=#E8EEF4;strokeColor=#7A8C9E;" parent="1" vertex="1">
